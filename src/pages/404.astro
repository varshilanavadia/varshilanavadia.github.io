---
// GitHub Pages serves dist/404.html, with a 404 status, for any path that has no file.
// A contour map drifts slowly behind the name band, which reads "Page not found"; a route
// wanders across it, takes a wrong turn and stops at "You are here". The pointer raises a
// hill in the terrain that follows it around. Under reduced motion it is one still map.
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Varshil Anavadia" bodyClass="page-short">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <main class="lost">
    <section class="stage" aria-hidden="true">
      <canvas id="terrain"></canvas>
      <p class="you-are-here" id="here">You are here</p>
      <div class="hero-name band">
        <div class="hero-name-track">
          {[0, 1, 2, 3].map(() => (
            <div class="hero-name-seg">Page not found<span class="hero-name-dash"></span></div>
          ))}
        </div>
      </div>
    </section>
    <section class="intro">
      <h1 class="sr-only">Page not found</h1>
      <p class="lost-note">What is not in your control, let go. <a href="/">Go back to the start</a>.</p>
    </section>
  </main>
</Base>

<style>
  .stage{position:relative;flex:1 0 auto;height:clamp(26rem, 72vh, 48rem);overflow:hidden;border-bottom:2px solid var(--rule)}
  .stage canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
  /* The map label: IBM Plex Mono, set as a tag on the dot, flipped left near the edge. */
  .you-are-here{position:absolute;left:0;top:0;margin:0;padding:0.3em 0.55em;font-family:var(--font-mono);font-size:0.75rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;background:var(--ink);color:var(--sheet);white-space:nowrap;opacity:0;transition:opacity .5s;transform:translate(14px,-50%)}
  .you-are-here.on{opacity:1}
  .you-are-here.flip{transform:translate(calc(-100% - 14px),-50%)}
  /* The band clips its overflow for the marquee, and its tight line box cut off the g's
     descender. Padding below makes room inside the clip; the band sits lower to match. */
  .band{bottom:clamp(0.5rem, 1.25vw, 1.25rem);padding-bottom:0.22em}
</style>

<script>
  const canvas = document.getElementById('terrain') as HTMLCanvasElement;
  const stage = canvas.parentElement as HTMLElement;
  const here = document.getElementById('here') as HTMLElement;
  const ctx = canvas.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const INK = '28,56,37';      // --color-text #1c3825, as r,g,b for the line alphas
  const ACCENT = '#1e7a47';    // --color-accent

  // ── Seeded value noise ────────────────────────────────────────────────────
  let seed = 404;
  const rand = () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  const perm = new Uint8Array(512);
  const vals = new Float32Array(256);
  for (let i = 0; i < 256; i++) { perm[i] = i; vals[i] = rand(); }
  for (let i = 255; i > 0; i--) { const j = Math.floor(rand() * (i + 1)); [perm[i], perm[j]] = [perm[j], perm[i]]; }
  for (let i = 0; i < 256; i++) perm[i + 256] = perm[i];
  const h = (x: number, y: number, z: number) => vals[perm[perm[perm[x & 255] + (y & 255)] + (z & 255)]];
  const f = (t: number) => t * t * (3 - 2 * t);
  const noise = (x: number, y: number, z: number) => {
    const xi = Math.floor(x), yi = Math.floor(y), zi = Math.floor(z);
    const u = f(x - xi), v = f(y - yi), w = f(z - zi);
    const l = (a: number, b: number, t: number) => a + (b - a) * t;
    return l(
      l(l(h(xi, yi, zi), h(xi + 1, yi, zi), u), l(h(xi, yi + 1, zi), h(xi + 1, yi + 1, zi), u), v),
      l(l(h(xi, yi, zi + 1), h(xi + 1, yi, zi + 1), u), l(h(xi, yi + 1, zi + 1), h(xi + 1, yi + 1, zi + 1), u), v),
      w,
    );
  };

  // ── The route: a wander that heads right, then takes a wrong turn and stops ─
  const route: [number, number][] = [];
  {
    let x = -0.04, y = 0.34, hd = 0.05;
    for (let i = 0; i < 110; i++) {
      route.push([x, y]);
      hd += (rand() - 0.5) * 0.38 - hd * 0.06;
      if (i > 78) hd -= 0.055; // the wrong turn: it veers up and away
      x += Math.cos(hd) * 0.0068;
      y = Math.min(0.5, Math.max(0.1, y + Math.sin(hd) * 0.012));
    }
  }

  // Terrain settings run from a phone (360px wide) to a laptop (1024px) and hold beyond:
  // phones get smaller hills and closer contour levels, so the map reads as dense as on a
  // wide screen. Blended, not switched, so a resizing window never jumps.
  let W = 0, H = 0, dpr = 1, step = 12, cols = 0, rows = 0, grid = new Float32Array(0);
  let scale = 260, gap = 0.06, levels = 11;
  const layout = () => {
    const r = stage.getBoundingClientRect();
    W = r.width; H = r.height;
    dpr = Math.min(2, devicePixelRatio || 1);
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    const k = Math.min(1, Math.max(0, (W - 360) / (1024 - 360)));
    scale = 135 + (260 - 135) * k;          // px per noise cell: the hills' size
    gap = 0.042 + (0.06 - 0.042) * k;       // height between contour levels
    levels = Math.floor(0.63 / gap) + 1;    // enough levels to reach the peaks
    step = Math.round(7 + (12 - 7) * k);    // sampling grid, finer for smaller hills
    cols = Math.ceil(W / step) + 1;
    rows = Math.ceil(H / step) + 1;
    grid = new Float32Array(cols * rows);
  };
  layout();

  // Pointer hill: eases toward the pointer, fades when it leaves.
  let tx = 0, ty = 0, hx = 0, hy = 0, amp = 0, want = 0;
  addEventListener('pointermove', (e) => {
    const r = stage.getBoundingClientRect();
    tx = e.clientX - r.left; ty = e.clientY - r.top;
    want = ty > -40 && ty < H + 40 ? 1 : 0;
    if (amp === 0) { hx = tx; hy = ty; }
  }, { passive: true });
  stage.addEventListener('pointerleave', () => { want = 0; });

  const contours = (z: number) => {
    const sc = 1 / scale;
    const sig2 = 2 * Math.pow(Math.min(W, H) * 0.16, 2);
    for (let j = 0; j < rows; j++) {
      for (let i = 0; i < cols; i++) {
        const x = i * step, y = j * step;
        let v = noise(x * sc, y * sc, z) * 0.68 + noise(x * sc * 2.3, y * sc * 2.3, z * 1.4 + 9) * 0.32;
        if (amp > 0.001) v += amp * 0.32 * Math.exp(-((x - hx) ** 2 + (y - hy) ** 2) / sig2);
        grid[j * cols + i] = v;
      }
    }
    for (let k = 0; k < levels; k++) {
      const lv = 0.2 + k * gap;
      const index = k % 4 === 1;
      ctx.beginPath();
      for (let j = 0; j < rows - 1; j++) {
        for (let i = 0; i < cols - 1; i++) {
          const a = grid[j * cols + i], b = grid[j * cols + i + 1];
          const c = grid[(j + 1) * cols + i + 1], d = grid[(j + 1) * cols + i];
          const cs = (a > lv ? 8 : 0) | (b > lv ? 4 : 0) | (c > lv ? 2 : 0) | (d > lv ? 1 : 0);
          if (cs === 0 || cs === 15) continue;
          const x = i * step, y = j * step;
          const top = (): [number, number] => [x + step * (lv - a) / (b - a), y];
          const right = (): [number, number] => [x + step, y + step * (lv - b) / (c - b)];
          const bottom = (): [number, number] => [x + step * (lv - d) / (c - d), y + step];
          const left = (): [number, number] => [x, y + step * (lv - a) / (d - a)];
          const seg = (p: [number, number], q: [number, number]) => { ctx.moveTo(p[0], p[1]); ctx.lineTo(q[0], q[1]); };
          switch (cs) {
            case 1: case 14: seg(left(), bottom()); break;
            case 2: case 13: seg(bottom(), right()); break;
            case 3: case 12: seg(left(), right()); break;
            case 4: case 11: seg(top(), right()); break;
            case 6: case 9: seg(top(), bottom()); break;
            case 7: case 8: seg(left(), top()); break;
            case 5: seg(left(), top()); seg(bottom(), right()); break;
            case 10: seg(top(), right()); seg(left(), bottom()); break;
          }
        }
      }
      ctx.strokeStyle = `rgba(${INK},${index ? 0.42 : 0.2})`;
      ctx.lineWidth = index ? 1.5 : 1;
      ctx.stroke();
    }
  };

  const drawRoute = (progress: number, t: number) => {
    const n = Math.max(2, Math.floor(route.length * progress));
    ctx.beginPath();
    for (let i = 0; i < n; i++) {
      const [x, y] = route[i];
      i ? ctx.lineTo(x * W, y * H) : ctx.moveTo(x * W, y * H);
    }
    ctx.lineJoin = ctx.lineCap = 'round';
    ctx.strokeStyle = ACCENT;
    ctx.lineWidth = 3.5;
    ctx.stroke();
    const [ex, ey] = route[n - 1];
    if (progress >= 1) {
      // A ring pulses out from the end point every two seconds.
      if (!reduce) {
        const p = (t % 2000) / 2000;
        ctx.beginPath();
        ctx.arc(ex * W, ey * H, 7 + p * 26, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(30,122,71,${0.55 * (1 - p)})`;
        ctx.lineWidth = 2;
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(ex * W, ey * H, 7, 0, Math.PI * 2);
      ctx.fillStyle = ACCENT;
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = '#e7ede9';
      ctx.stroke();
      here.style.left = `${ex * W}px`;
      here.style.top = `${ey * H}px`;
      // Flip the label to the dot's left if it would run off the right edge.
      here.classList.toggle('flip', ex * W + 14 + here.offsetWidth > W - 8);
      here.classList.add('on');
    }
  };

  // ── Name band: a plain drift, same parts as the home page's marquee ────────
  const track = stage.querySelector('.hero-name-track') as HTMLElement;
  let seg = 0, mx = 0;
  const measure = () => {
    const first = track.firstElementChild as HTMLElement | null;
    seg = first ? first.offsetWidth + (parseFloat(getComputedStyle(track).columnGap) || 0) : 0;
  };
  document.fonts.addEventListener('loadingdone', () => { seg = 0; });

  const frame = (t: number, dt: number, progress: number) => {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    contours(t / 1000 * 0.045);
    drawRoute(progress, t);
    if (!reduce) {
      if (!seg) measure();
      if (seg > 0) {
        mx = (mx + 70 * dt) % seg;
        track.style.transform = `translate3d(${mx - seg}px,0,0)`;
      }
    }
  };
  const still = () => frame(0, 0, 1);

  // Watch the stage itself, not the window: on a phone its height settles after load (the
  // browser bars move), and a canvas sized to a stale height gets stretched to fit.
  new ResizeObserver(() => { layout(); seg = 0; if (reduce) still(); }).observe(stage);

  if (reduce) {
    still();
  } else {
    const t0 = performance.now();
    let last = t0;
    const tick = (t: number) => {
      const dt = Math.min(0.05, (t - last) / 1000);
      last = t;
      amp += (want - amp) * Math.min(1, dt * 2.5);
      hx += (tx - hx) * Math.min(1, dt * 4);
      hy += (ty - hy) * Math.min(1, dt * 4);
      const p = Math.min(1, (t - t0 - 400) / 2600);
      frame(t, dt, Math.max(0, p) ** 0.8);
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
