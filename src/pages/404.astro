---
// GitHub Pages serves dist/404.html, with a 404 status, for any path that has no file.
// A contour map (ContourMap) drifts slowly behind the name band, which reads "Page not
// found"; a route wanders across it, takes a wrong turn and stops at "You are here".
import Base from '../layouts/Base.astro';
import ContourMap from '../components/ContourMap.astro';
---

<Base title="Page not found · Varshil Anavadia" bodyClass="page-short">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <main class="lost">
    <section class="stage" aria-hidden="true">
      <ContourMap route="wrong-turn" label="You are here" />
      <div class="hero-name band">
        <div class="hero-name-track">
          {[0, 1, 2, 3].map(() => (
            <div class="hero-name-seg">Page not found<span class="hero-name-dash"></span></div>
          ))}
        </div>
      </div>
    </section>
    <section class="intro">
      <h1 class="sr-only">Page not found</h1>
      <p class="lost-note">What is not in your control, let go. <a href="/">Go back to the start</a>.</p>
    </section>
  </main>
</Base>

<style>
  .stage{position:relative;flex:1 0 auto;height:clamp(26rem, 72vh, 48rem);overflow:hidden;border-bottom:2px solid var(--rule)}
  /* The band clips its overflow for the marquee, and its tight line box cut off the g's
     descender. Padding below makes room inside the clip; the band sits lower to match. */
  .band{bottom:clamp(0.5rem, 1.25vw, 1.25rem);padding-bottom:0.22em}
</style>

<script>
  // The name band: a plain drift, the same parts as the home page's marquee. The map behind
  // it is its own component.
  const track = document.querySelector<HTMLElement>('.stage .hero-name-track');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (track && !reduce) {
    let seg = 0, mx = 0, last = performance.now();
    const measure = () => {
      const first = track.firstElementChild as HTMLElement | null;
      seg = first ? first.offsetWidth + (parseFloat(getComputedStyle(track).columnGap) || 0) : 0;
    };
    document.fonts.addEventListener('loadingdone', () => { seg = 0; });
    addEventListener('resize', () => { seg = 0; });
    const tick = (t: number) => {
      const dt = Math.min(0.05, (t - last) / 1000);
      last = t;
      if (!seg) measure();
      if (seg > 0) {
        mx = (mx + 70 * dt) % seg;
        track.style.transform = `translate3d(${mx - seg}px,0,0)`;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

