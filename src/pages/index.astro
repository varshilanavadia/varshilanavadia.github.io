---
import Base from '../layouts/Base.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import HeroGradient from '../components/HeroGradient.astro';
import Work from '../components/Work.astro';
import { links, sections } from '../site';
import thoughts from '../data/thoughts.json';
// The thought-of-the-day picker, as source text, to inline as it is: shipped and tested alike.
import pickThoughtSource from '../scripts/pick-thought.js?raw';

const canonical = new URL('/', Astro.site).href;


// Thought of the day. A day number is whole days since 1 Jan 2026, which is the arithmetic
// the picker below runs on the visitor's local date. Working the dates out here keeps them
// out of the page: the browser is handed a text and a number per thought and nothing else.
// A date that is not a real day written YYYY-MM-DD stops the build. Written another way
// (10/2/2026, as a spreadsheet may give it) it would reach the page as null, and one that
// does not exist (2026-02-30) would roll over into the next month: either way the rotation's
// past days would silently reshuffle, with the build and its check still passing.
const EPOCH = Date.UTC(2026, 0, 1);
const dayNumber = (iso: string) => {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(iso));
  const t = m ? Date.UTC(+m[1], +m[2] - 1, +m[3]) : NaN;
  if (!m || new Date(t).toISOString().slice(0, 10) !== iso) {
    throw new Error(`src/data/thoughts.json: "${iso}" is not a date written YYYY-MM-DD.`);
  }
  return Math.floor((t - EPOCH) / 86400000);
};
const thoughtData = thoughts.map((t) => [t.text, dayNumber(t.added)]);

// Share preview strings and image, from Share Preview.dc.html (17 Sep 2026). The description
// is the owner's own words, drawn from the About section (3 Oct 2026): what a search result
// and a shared link say under the name. Kept to 160 characters, about where both cut it off.
const title = 'Varshil Anavadia';
const description =
  'I’m firstly a human being and then an Engineer. Currently a Software Engineer at Oracle, developing and delivering the #1 cloud ERP system. Based in Austin, TX.';
const shareImage = new URL('/assets/og-card.png', Astro.site).href;
const shareImageAlt = 'The VA monogram above the name Varshil Anavadia, pale green on dark green';

// Tells search engines who the page is about and which profiles are the same person, so a
// search for the name can connect this site with LinkedIn, GitHub, Strava and Instagram.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${canonical}#person`,
      name: 'Varshil Anavadia',
      url: canonical,
      sameAs: links.map((link) => link.href),
    },
    {
      '@type': 'WebSite',
      name: 'Varshil Anavadia',
      url: canonical,
      author: { '@id': `${canonical}#person` },
    },
  ],
};
---

<Base title={title} sections={sections}>
  <Fragment slot="head">
    <meta name="description" content={description} />
    <!-- Share preview, high in the head: WhatsApp reads only the start of a document. The
         image URL must stay absolute. Ship a changed card under a new URL, never in place. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <!-- The page may be indexed; the portrait may not. GitHub Pages cannot send headers, so
         public/robots.txt keeps crawlers off the file itself; nothing stops another site
         embedding it. -->
    <meta name="robots" content="index, follow, noimageindex" />
    <link rel="canonical" href={canonical} />
    <!-- The paper cutout is the largest thing on screen, but as a CSS mask the browser would
         find it only once the stylesheet is in, and at low priority. Masks are fetched in CORS
         mode, so the preload carries crossorigin to match, or Chrome fetches the file twice. -->
    <link rel="preload" as="image" href="/hero-paper.webp" type="image/webp" fetchpriority="high" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <main>
    <section class="hero">
      <!-- The moving gradient behind everything in the hero. First, so all that follows
           paints above it. -->
      <HeroGradient />
      <h1 class="sr-only">Varshil Anavadia</h1>
      <div class="hero-name" aria-hidden="true">
        <div class="hero-name-track">
          {[0, 1, 2, 3].map(() => (
            <div class="hero-name-seg">
              Varshil Anavadia<span class="hero-name-dash"></span>
            </div>
          ))}
        </div>
      </div>
      <!-- The portrait as a paper cutout. Back to front: the paper (the figure's outline grown
           outward, scripts/make-paper.py), the band, a copy of the band masked to the paper that
           redraws the letters in ink where they cross it, the portrait, and a copy masked to the
           figure. No .grayscale: the file is already black and white apart from the yellow bar,
           which the filter would flatten. -->
      <!-- Shown only where the tilt needs permission and has not been given it: iOS. The
           script unhides it, and it leaves for good on the first gesture. Hidden from screen
           readers: it names a gesture, not content, and any tap at all answers it. -->
      <p class="tilt-hint" id="tilt-hint" aria-hidden="true" hidden>Tap to tilt</p>
      <div class="portrait-frame">
        <div class="paper" aria-hidden="true"><div class="paper-shape"></div></div>
        <div class="paper-ink" aria-hidden="true">
          <div class="hero-name hero-name--over hero-name--paper">
            <div class="hero-name-track">
              {[0, 1, 2, 3].map(() => (
                <div class="hero-name-seg">
                  Varshil Anavadia<span class="hero-name-dash"></span>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="portrait">
          <img
            src="/hero-portrait.webp"
            alt="Portrait of Varshil Anavadia"
            draggable="false"
            width="835"
            height="1113"
            fetchpriority="high"
          />
          <div class="hero-name hero-name--over" aria-hidden="true">
            <div class="hero-name-track">
              {[0, 1, 2, 3].map(() => (
                <div class="hero-name-seg">
                  Varshil Anavadia<span class="hero-name-dash"></span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <About />
    <Work />
    <Contact />
  </main>

  <Fragment slot="foot">
    <p class="block-label">Thought of the day</p>
    {/* The first thought in the file is what ships in the HTML: what a visitor without
        JavaScript reads, and what a crawler indexes. The script below replaces it. */}
    <blockquote id="thought-of-the-day">{thoughts[0].text}</blockquote>
    <script is:inline set:html={pickThoughtSource} />
    <script is:inline define:vars={{ THOUGHTS: thoughtData }}>
      // The day is the visitor's own: the thought is picked here from their local date, so it
      // turns over at their midnight and publishing needs no daily rebuild. Everyone whose
      // local date is the same reads the same thought, and it cannot change during their day.
      //
      // Inline and in the parser's path, immediately after the <blockquote>, so the text is
      // replaced before the page is painted and no other thought is ever visible.
      (() => {
        const DAY = 86400000;
        const EPOCH = Date.UTC(2026, 0, 1);
        // window.__dayOffset is the dev panel's day stepper. The panel never ships, so in
        // the published build the offset is always nothing.
        const today = () => {
          const d = new Date();
          return (
            Math.floor((Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - EPOCH) / DAY) +
            (window.__dayOffset || 0)
          );
        };

        // pickThought is src/scripts/pick-thought.js, inlined just above: the rounds and
        // the shuffle live there, where test/ checks them.
        const pick = (day) => pickThought(THOUGHTS, day);

        const el = document.getElementById('thought-of-the-day');
        // What the markup shipped, so a previewed day with nothing eligible yet puts it back
        // rather than leaving another day's thought on screen.
        const shipped = el.textContent;
        let shownDay = null;
        const render = () => {
          shownDay = today();
          const thought = pick(shownDay);
          el.textContent = thought ? thought[0] : shipped;
        };
        render();

        // A tab left open past midnight, or brought back by Back or Forward from the browser's
        // page cache, would keep yesterday's thought. The date is looked at again whenever the
        // page is shown, and at the visitor's own midnight while it stays open; the thought
        // changes only if the day has.
        const refresh = () => { if (today() !== shownDay) render(); };
        addEventListener('pageshow', (e) => { if (e.persisted) refresh(); });
        document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
        const atMidnight = () => {
          const now = new Date();
          const next = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
          setTimeout(() => { refresh(); atMidnight(); }, next - now + 1000);
        };
        atMidnight();

        // Read by the dev panel's day stepper, which is local-only.
        window.__thoughtOfTheDay = {
          render,
          // "20 Sep": month names spelled out here, since locale data differs by browser (a
          // current one gives UK English "Sept").
          label: () => {
            const d = new Date(EPOCH + today() * DAY);
            return `${d.getUTCDate()} ${'Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec'.split(' ')[d.getUTCMonth()]}`;
          },
        };
      })();
    </script>
  </Fragment>

  <script>
    // Hero name marquee, ported from the wireframe. A base drift carries the name right;
    // every scroll delta adds to a boost that decays, so scrolling down runs it faster and
    // scrolling up drags it left. The track holds four copies of "name + dash" and the
    // offset wraps modulo one copy's width, so the seam never shows.
    // Three tracks: the band, its copy on the paper, and its copy on the figure. One loop
    // drives all three, so they can never drift apart.
    const tracks = Array.from(document.querySelectorAll<HTMLElement>('.hero-name-track'));
    const track = tracks[0];
    if (track) {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)');
      let seg = 0;
      let mx = 0;
      let boost = 0;
      let dir = 1;
      let lastY = scrollY;
      let raf = 0;
      let last = 0;

      const measure = () => {
        const first = track.firstElementChild as HTMLElement | null;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        seg = first ? first.offsetWidth + gap : 0;
      };

      addEventListener(
        'scroll',
        () => {
          const d = scrollY - lastY;
          if (d !== 0) dir = d < 0 ? -1 : 1;
          // 2.4px of extra travel per px scrolled, clamped so a flick cannot smear the name.
          boost = Math.max(-800, Math.min(800, boost + d * 2.4));
          lastY = scrollY;
        },
        { passive: true },
      );
      addEventListener('resize', () => { seg = 0; });
      // Re-measure once the webfont has swapped in; the fallback face has different widths.
      document.fonts.addEventListener('loadingdone', () => { seg = 0; });

      // Depth. The portrait's layers drift one way and the band the other, so they seem to
      // sit at different distances. The phone's own tilt drives it; a mouse drives it from
      // where the pointer is over the hero. iOS hands out no readings until asked, and asks
      // only from a gesture, so there the scroll position drives it until any gesture at all
      // raises the prompt; tilt takes over for good once it is allowed, and iOS remembers
      // the answer for the site, so it is asked once rather than on every visit. Scrolling
      // is not a gesture a browser will accept, which leaves the taps and key presses below.
      // The offsets go on the layers themselves, never on .portrait-frame, which must not
      // become a stacking context (see site.css).
      const hero = document.querySelector<HTMLElement>('.hero')!;
      const clamp = (v: number) => Math.max(-1, Math.min(1, v));
      let px = 0, py = 0, inside = false, dx = 0, dy = 0;
      hero.addEventListener('pointermove', (e) => {
        if (e.pointerType === 'touch') return;
        px = e.clientX; py = e.clientY; inside = true;
      });
      hero.addEventListener('pointerleave', () => { inside = false; });

      const hint = document.getElementById('tilt-hint');
      const hideHint = () => {
        hint?.classList.remove('on');
        setTimeout(() => { if (hint) hint.hidden = true; }, 600);
      };

      // Tilt is read against the screen as it is turned, not from the phone's raw angles, which
      // swap axes in landscape and jump by half a turn when a phone or tablet is held upright.
      // up() is which way is up in the device's own axes (x to the right of the screen held
      // upright, y to its top, z out of it, as the Device Orientation spec has them); tilt()
      // reads that against the screen's right and top: roll, its right side dropping, and
      // pitch, its top raised toward the viewer, in degrees.
      const RAD = Math.PI / 180;
      const SCREEN: Record<number, [number[], number[]]> = {
        0: [[1, 0, 0], [0, 1, 0]],
        90: [[0, -1, 0], [1, 0, 0]],
        180: [[-1, 0, 0], [0, -1, 0]],
        270: [[0, 1, 0], [-1, 0, 0]],
      };
      const up = (beta: number, gamma: number) => {
        const b = beta * RAD, g = gamma * RAD;
        return [-Math.sin(g) * Math.cos(b), Math.sin(b), Math.cos(g) * Math.cos(b)];
      };
      // screen.orientation where there is one; iOS before 16.4 has only window.orientation.
      const turn = () => {
        const a = screen.orientation?.angle ?? (window as any).orientation ?? 0;
        return (((Math.round(a / 90) * 90) % 360) + 360) % 360;
      };
      const tilt = (u: number[]) => {
        const [r, s] = SCREEN[turn()];
        const dot = (a: number[], b: number[]) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
        return [Math.asin(Math.max(-1, Math.min(1, -dot(u, r)))) / RAD, Math.atan2(dot(u, s), u[2]) / RAD];
      };

      // The rest position is how the device is held: the first reading, then easing after it
      // with a 3s time constant, so a held tilt settles back over a few seconds and a phone
      // picked up off a table finds its new rest rather than pinning the layers in a corner.
      // A turn of the screen starts it afresh. Once readings flow there is nothing left to
      // ask for, so the hint goes too. The listener runs only while the depth does (start and
      // stop, below), so the sensor is off while the hero is off screen.
      let tiltX = 0, tiltY = 0, reading = false;
      let rest: number[] | null = null, restAt = 0;
      const wrap = (d: number) => ((d + 540) % 360) - 180;
      const onTilt = (e: DeviceOrientationEvent) => {
        if (e.gamma == null || e.beta == null) return;
        const [roll, pitch] = tilt(up(e.beta, e.gamma));
        if (!reading) { reading = true; hideHint(); }
        if (!rest) { rest = [roll, pitch]; restAt = e.timeStamp; }
        const k = 1 - Math.exp(-Math.max(0, e.timeStamp - restAt) / 3000);
        restAt = e.timeStamp;
        rest = [rest[0] + wrap(roll - rest[0]) * k, rest[1] + wrap(pitch - rest[1]) * k];
        tiltX = clamp(wrap(roll - rest[0]) / 22);
        tiltY = clamp(wrap(pitch - rest[1]) / 22);
      };
      const turned = () => { rest = null; };
      if (screen.orientation) screen.orientation.addEventListener('change', turned);
      else addEventListener('orientationchange', turned);

      // Waiting holds the depth still for a moment after the page arrives, in case readings
      // are about to land, so the layers don't start on the scroll and jump to the tilt.
      // After that the scroll drives it until tilt does, since a device can carry the event
      // and never fire it, and iOS fires none until asked.
      let waiting = true;
      setTimeout(() => { waiting = false; }, 1500);

      // Only a phone or tablet is asked. Chrome and its relatives carry the call too since
      // version 152, but a desktop has nothing to tilt. The call is read off window because
      // the event exists only on https or localhost, not on a LAN address.
      const orientation = (window as any).DeviceOrientationEvent;
      const askApi = orientation?.requestPermission;
      if (typeof askApi === 'function' && matchMedia('(pointer: coarse)').matches) {
        // The hint invites the gesture the prompt needs, since nothing else on the page
        // asks to be touched. It arrives a moment after the page, only where no reading has
        // arrived by then (Android's Chrome sends them without asking), and leaves on the
        // first gesture whatever the answer, rather than nagging.
        let touched = false;
        if (hint) {
          setTimeout(() => {
            if (touched || reading || reduce.matches) return;
            hint.hidden = false;
            requestAnimationFrame(() => hint.classList.add('on'));
          }, 1500);
        }
        let asked = false;
        const ask = () => {
          if (!touched) { touched = true; hideHint(); }
          // Nothing to ask for where readings already flow, and nothing to unlock under
          // reduced motion, where the depth never runs.
          if (asked || reading || reduce.matches) return;
          asked = true;
          askApi.call(orientation).then(
            (state: string) => { if (state !== 'granted') asked = false; },
            () => { asked = false; },
          );
        };
        // Every event a browser counts as user activation, captured so a tap on a link
        // still raises the prompt before the page leaves. A tap on a page with nothing
        // clickable often fires no click on iOS, hence the raw touch and pointer events;
        // the keyboard ones are for an attached keyboard.
        const gestures = ['pointerdown', 'pointerup', 'touchstart', 'touchend', 'mousedown', 'mouseup', 'click', 'keydown', 'keyup'];
        for (const type of gestures) addEventListener(type, ask, { capture: true, passive: true });
      }

      const depth = (dt: number) => {
        let tx = 0, ty = 0;
        if (inside) {
          // The pointer's place in the hero, from its centre.
          const r = hero.getBoundingClientRect();
          tx = clamp(((px - r.left) / r.width - 0.5) * 2);
          ty = clamp(((py - r.top) / r.height - 0.5) * 2);
        } else if (reading) {
          tx = tiltX; ty = tiltY;
        } else if (!waiting) {
          // How far the hero has travelled up the window, from -1 below it to 1 above.
          const r = hero.getBoundingClientRect();
          ty = clamp(((innerHeight - r.top) / (innerHeight + r.height) - 0.5) * 2);
        }
        const k = 1 - Math.pow(0.03, dt);
        dx += (tx - dx) * k; dy += (ty - dy) * k;
        // 42 and 24px at the corners for the portrait, against 30 and 12 for the band.
        hero.style.setProperty('--dx', `${(dx * 42).toFixed(2)}px`);
        hero.style.setProperty('--dy', `${(dy * 24).toFixed(2)}px`);
        hero.style.setProperty('--bx', `${(-dx * 30).toFixed(2)}px`);
        hero.style.setProperty('--by', `${(-dy * 12).toFixed(2)}px`);
      };

      const tick = (t: number) => {
        const dt = Math.min(0.064, (t - last) / 1000);
        last = t;
        depth(dt);
        if (!seg) measure();
        if (seg > 0) {
          mx = (((mx + (100 * dir + boost) * dt) % seg) + seg) % seg;
          boost *= Math.pow(0.02, dt); // decays to nothing in about a third of a second
          // Direction eases back to rightward once the gesture stops.
          dir += (1 - dir) * (1 - Math.pow(0.15, dt));
          const shift = `translate3d(${mx - seg}px,0,0)`;
          for (const el of tracks) el.style.transform = shift;
        }
        raf = requestAnimationFrame(tick);
      };

      const start = () => {
        if (raf || reduce.matches) return;
        last = performance.now();
        raf = requestAnimationFrame(tick);
        addEventListener('deviceorientation', onTilt);
      };
      const stop = () => {
        cancelAnimationFrame(raf);
        raf = 0;
        removeEventListener('deviceorientation', onTilt);
      };

      // Run only while the hero is on screen, and not at all under reduced motion. The hero,
      // not the band: on a phone held sideways the band can be below the fold while the
      // portrait, and its depth, are in view. Switching reduced motion off starts it again
      // only if the hero is on screen.
      let onScreen = false;
      new IntersectionObserver(([entry]) => {
        onScreen = !!entry?.isIntersecting;
        if (onScreen) start();
        else stop();
      }).observe(hero);
      reduce.addEventListener('change', () => (reduce.matches || !onScreen ? stop() : start()));
    }
  </script>
</Base>
