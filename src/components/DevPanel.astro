---
// Local-only panel of page controls, rendered by Base.astro when devPanel is on. Each
// control sets a data-* attribute on <html> that the stylesheets can read; choices persist
// in localStorage. Script and styles are inline, so none of it reaches the published
// bundle when the panel is off. To add a control, add an entry to CONTROLS: key, label, and
// options as [value, label] pairs, the first being the default (which clears the attribute).
// The day stepper below is not one of those: it previews another date rather than setting an
// attribute, so it is built on its own. The Contact row is one, though no stylesheet reads it:
// the stand-in for fetch below does, to rehearse the Contact form's replies. The four numbered
// rows after it each take one part of the bracket button's spill away, to see what it adds.
// The class name dev-panel is what scripts/check-build.mjs looks for: both workflows run it, and
// it fails a build that mentions the name anywhere, which is how a panel that escaped into
// production gets caught. Renaming it here without changing that script leaves the gate
// passing on anything.
---
<script is:inline>
  (() => {
    const CONTROLS = [
      { key: 'theme', label: 'Theme', options: [['device', 'Device'], ['light', 'Light'], ['dark', 'Dark']] },
      { key: 'contact', label: 'Contact', options: [['live', 'Live'], ['sent', 'Sent'], ['refused', 'Refused'], ['busy', 'Busy'], ['offline', 'Offline']] },
      { key: 'pour', label: '1 Pour', options: [['on', 'On'], ['off', 'Off']] },
      { key: 'wobble', label: '2 Wobble', options: [['on', 'On'], ['off', 'Off']] },
      { key: 'sheen', label: '3 Sheen', options: [['on', 'On'], ['off', 'Off']] },
      { key: 'shadow', label: '4 Shadow', options: [['on', 'On'], ['off', 'Off']] },
      { key: 'liquid', label: '5 Liquid', options: [['simulated', 'Simulated'], ['circles', 'Circles']] },
    ];
    const root = document.documentElement;
    const STORE = 'devPanel';
    let state = {};
    try { state = JSON.parse(localStorage.getItem(STORE) || '{}'); } catch {}
    const save = () => { try { localStorage.setItem(STORE, JSON.stringify(state)); } catch {} };
    const apply = (c, v) => {
      if (v === c.options[0][0]) delete root.dataset[c.key];
      else root.dataset[c.key] = v;
    };
    // Applied before first paint, so a forced theme never flashes the other one.
    for (const c of CONTROLS) if (state[c.key]) apply(c, state[c.key]);

    // The thought of the day is picked from the visitor's local date. This shifts that date by
    // a number of days so any day's thought, and how it wraps, can be read on a phone without
    // touching the clock. Set here, at head time, so the thought script down in the footer
    // picks the previewed day on first paint too, rather than correcting itself afterwards.
    window.__dayOffset = state.dayOffset || 0;

    // The Contact form's replies, rehearsed. On Live the form really sends, to the owner's
    // inbox. On anything else a request to Formspree goes nowhere and is answered here after
    // a moment, in Formspree's own words (src/scripts/formspree.ts has the format): sent,
    // the email address refused, its rate limit, or no connection at all. So every state of
    // the form can be read, on a phone too, without a message being sent. Only the page's
    // script is caught: with JavaScript off the form posts for real, whatever this says.
    const REPLIES = {
      sent: [200, { next: '/thanks', ok: true }],
      refused: [422, { error: 'Validation errors', errors: [{ code: 'TYPE_EMAIL', field: 'email', message: 'should be an email' }] }],
      busy: [429, { error: 'Too many requests', errors: [{ code: 'RATE_LIMITED', message: 'Too many requests' }] }],
    };
    const send = window.fetch;
    window.fetch = (input, init) => {
      const mode = root.dataset.contact;
      const url = typeof input === 'string' ? input : input.url || String(input);
      if (!mode || !url.startsWith('https://formspree.io/')) return send(input, init);
      return new Promise((resolve, reject) => setTimeout(() => {
        const reply = REPLIES[mode];
        if (!reply) reject(new TypeError('Failed to fetch'));
        else resolve(new Response(JSON.stringify(reply[1]), { status: reply[0], headers: { 'Content-Type': 'application/json' } }));
      }, 1200));
    };

    // 2 Wobble is the one part of the spill no stylesheet can reach: the noise's push is an
    // attribute of the filter (BracketButton.astro), so Off sets it to nothing by hand. Each
    // button is first given a nudge (a blur it listens for), so that it has taken up
    // 5 Liquid's choice before its filter is touched; where it simulates the liquid it has
    // set the push to nothing itself, and is left alone.
    const wobble = () => {
      for (const button of document.querySelectorAll('.bracket-button')) button.dispatchEvent(new Event('blur'));
      for (const push of document.querySelectorAll('.bracket-button-wobble')) {
        if (push.closest('[data-simulated]')) continue;
        push.dataset.scale ??= push.getAttribute('scale');
        push.setAttribute('scale', root.dataset.wobble === 'off' ? '0' : push.dataset.scale);
      }
    };

    addEventListener('DOMContentLoaded', () => {
      wobble();
      const panel = document.createElement('aside');
      panel.className = 'dev-panel';
      panel.setAttribute('aria-label', 'Top Secret Tools, local dev panel');
      // Closed unless it was left open: the page should be the first thing you see.
      if (state._open !== true) panel.dataset.closed = '';
      const head = document.createElement('button');
      head.className = 'dev-panel-head';
      head.textContent = 'Top Secret Tools';
      head.addEventListener('click', () => {
        panel.toggleAttribute('data-closed');
        state._open = !panel.hasAttribute('data-closed');
        save();
      });
      panel.append(head);
      for (const c of CONTROLS) {
        const row = document.createElement('div');
        row.className = 'dev-panel-row';
        row.innerHTML = `<span>${c.label}</span>`;
        const cur = () => state[c.key] || c.options[0][0];
        for (const [v, text] of c.options) {
          const b = document.createElement('button');
          b.textContent = text;
          b.addEventListener('click', () => {
            state[c.key] = v; apply(c, v); save(); wobble();
            row.querySelectorAll('button').forEach((x, i) => x.setAttribute('aria-pressed', String(c.options[i][0] === v)));
          });
          b.setAttribute('aria-pressed', String(cur() === v));
          row.append(b);
        }
        panel.append(row);
      }

      // Day stepper, only on pages that carry a thought. Not a CONTROLS row: it steps a
      // number rather than choosing one of a set of values.
      const thought = window.__thoughtOfTheDay;
      if (thought) {
        const row = document.createElement('div');
        row.className = 'dev-panel-row';
        row.innerHTML = '<span>Day</span>';
        const shown = document.createElement('span');
        shown.className = 'dev-panel-date';
        // Thoughts differ in length, so swapping one changes the page's height and the view
        // drifts under you. Two things keep it still: a spacer that stops the page ever
        // getting shorter during a session (at the foot of the page the browser would
        // otherwise pull the view up, and no amount of scrolling could correct it), and a
        // scroll nudge by however far the thought itself moved. Both are local only.
        const el = document.querySelector('.foot blockquote');
        const spacer = document.createElement('div');
        spacer.setAttribute('aria-hidden', 'true');
        document.body.append(spacer);
        let peak = 0;
        const hold = () => {
          spacer.style.height = '0px';
          const h = document.documentElement.scrollHeight;
          peak = Math.max(peak, h);
          spacer.style.height = `${peak - h}px`;
        };
        hold();
        const step = (by) => {
          state.dayOffset = by === 0 ? 0 : (state.dayOffset || 0) + by;
          window.__dayOffset = state.dayOffset;
          save();
          const before = el ? el.getBoundingClientRect().top : 0;
          thought.render();
          hold();
          if (el) {
            const moved = el.getBoundingClientRect().top - before;
            if (moved) scrollBy({ top: moved, behavior: 'instant' });
          }
          shown.textContent = thought.label();
        };
        for (const [text, by] of [['\u2039', -1], ['Today', 0], ['\u203a', 1]]) {
          const b = document.createElement('button');
          b.textContent = text;
          b.addEventListener('click', () => step(by));
          row.append(b);
        }
        row.append(shown);
        panel.append(row);
        // The offset was applied at head time, so the thought on screen is already right for
        // the previewed day; only the date beside the buttons needs filling in.
        shown.textContent = thought.label();
      }

      document.body.append(panel);

      // Dock mode shortens the page by the strip's height rather than covering it, so the
      // measurement has to follow the panel as controls are added or it wraps.
      const measure = () => root.style.setProperty('--dev-panel-h', `${panel.offsetHeight}px`);
      new ResizeObserver(measure).observe(panel);
      measure();

      // Backtick opens and closes the panel, so the page can be read unobstructed.
      addEventListener('keydown', (e) => {
        if (e.key !== '`' || e.metaKey || e.ctrlKey || e.altKey) return;
        const tag = document.activeElement && document.activeElement.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA') return;
        panel.toggleAttribute('data-closed');
        state._open = !panel.hasAttribute('data-closed');
        save();
        measure();
      });
    });
  })();
</script>
<style is:inline>
  /* Docked along the head of the window, and shortening the page by its own height so it
     never covers anything; the site's own sticky bar is pushed down by that height so the
     two cannot overlap. No rule or shadow along its foot: the home page's bar and hero run
     on from it as one field. Its leading is the face's own, not the page's 1.5, so the strip
     stays as shallow as it was. */
  .dev-panel{position:fixed;left:0;right:0;top:0;z-index:1000;box-sizing:border-box;display:flex;flex-wrap:wrap;align-items:center;gap:6px 16px;padding:8px var(--gutter);max-width:100vw;overflow-wrap:anywhere;background:var(--sheet);color:var(--ink);font-family:var(--font-mono);font-size:11px;font-weight:700;line-height:normal;letter-spacing:0.04em;text-transform:uppercase}
  body{padding-top:var(--dev-panel-h, 0px)}
  /* :root for weight: site.css's own .bar{top:0} comes later in the page and would otherwise
     win, pinning the bar under this strip. */
  :root .bar{top:var(--dev-panel-h, 0px)}
  /* A link to a section stops it below the bar (site.css), so below this strip too. */
  :root .section{scroll-margin-top:calc(var(--bar-h, 0px) + var(--dev-panel-h, 0px))}
  .dev-panel button{flex:0 0 auto;font:inherit;letter-spacing:inherit;text-transform:inherit;padding:6px 8px;white-space:nowrap;border:1px solid var(--ink);background:transparent;color:var(--ink);cursor:pointer}
  .dev-panel button[aria-pressed="true"]{background:var(--ink);color:var(--sheet)}
  .dev-panel-head{border:0 !important;padding:0 !important;text-align:left}
  .dev-panel-head::after{content:' ▾'}
  .dev-panel[data-closed] .dev-panel-head::after{content:' ▸'}
  .dev-panel[data-closed] .dev-panel-row{display:none}
  /* Rows wrap within themselves and the strip wraps between them, so nothing runs off a
     narrow screen. The label holds a column so the rows line up while they fit. */
  .dev-panel-row{display:flex;align-items:center;flex-wrap:wrap;gap:4px;max-width:100%}
  .dev-panel-row > span:first-child{flex:0 0 auto;min-width:4.5em;color:var(--ink-3)}
  /* The bracket button's spill (BracketButton.astro), a part at a time.
     5 Liquid chooses how the ink moves: Simulated, a small fluid simulation, which is what
     the site does; or Circles, the nine circles the styles pour, which is what a visitor
     without JavaScript gets. The button's script reads it.
     The other four each take one thing away, so its share of the effect can be seen:
     1 Pour (Circles only): the circles swell where they end up, as Claude Design drew
       them, rather than pouring in from the brackets' corners.
     2 Wobble (Circles only): no noise on the edge (the script above), so the edges are
       arcs of circles.
     3 Sheen: no darker rim and no glint, so the ink is flat.
     4 Shadow: no shadow on the page. */
  :root[data-pour="off"] .bracket-button .bracket-button-circle{left:var(--x);top:var(--y)}
  :root[data-sheen="off"] .bracket-button :is(.bracket-button-sheen,.bracket-button-shade){flood-opacity:0}
  :root[data-shadow="off"] .bracket-button .bracket-button-shadow{flood-opacity:0}
  .dev-panel-date{flex:1 1 auto;min-width:0;margin-left:4px;color:var(--ink-3);white-space:normal;overflow-wrap:anywhere;text-transform:none;letter-spacing:0}
</style>
