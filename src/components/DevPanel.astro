---
// Local-only panel of page controls, rendered by Base.astro when devPanel is on. Each
// control sets a data-* attribute on <html> that the stylesheets can read; choices persist
// in localStorage. Script and styles are inline, so none of it reaches the published
// bundle when the panel is off. To add a control, add an entry to CONTROLS: key, label, and
// options as [value, label] pairs, the first being the default (which clears the attribute).
// The day stepper below is not one of those: it previews another date rather than setting an
// attribute, so it is built on its own.
---
<script is:inline>
  (() => {
    const CONTROLS = [
      { key: 'theme', label: 'Theme', options: [['device', 'Device'], ['light', 'Light'], ['dark', 'Dark']] },
    ];
    const root = document.documentElement;
    const STORE = 'devPanel';
    let state = {};
    try { state = JSON.parse(localStorage.getItem(STORE) || '{}'); } catch {}
    const save = () => { try { localStorage.setItem(STORE, JSON.stringify(state)); } catch {} };
    const apply = (c, v) => {
      if (v === c.options[0][0]) delete root.dataset[c.key];
      else root.dataset[c.key] = v;
    };
    // Applied before first paint, so a forced theme never flashes the other one.
    for (const c of CONTROLS) if (state[c.key]) apply(c, state[c.key]);

    // The quote of the day is picked from the visitor's local date. This shifts that date by
    // a number of days so any day's quote, and how it wraps, can be read on a phone without
    // touching the clock. Set here, at head time, so the quote script down in the footer
    // picks the previewed day on first paint too, rather than correcting itself afterwards.
    window.__dayOffset = state.dayOffset || 0;

    addEventListener('DOMContentLoaded', () => {
      const panel = document.createElement('aside');
      panel.className = 'dev-panel';
      panel.setAttribute('aria-label', 'Top Secret Tools, local dev panel');
      // Closed unless it was left open: the page should be the first thing you see.
      if (state._open !== true) panel.dataset.closed = '';
      const head = document.createElement('button');
      head.className = 'dev-panel-head';
      head.textContent = 'Top Secret Tools';
      head.addEventListener('click', () => {
        panel.toggleAttribute('data-closed');
        state._open = !panel.hasAttribute('data-closed');
        save();
      });
      panel.append(head);
      for (const c of CONTROLS) {
        const row = document.createElement('div');
        row.className = 'dev-panel-row';
        row.innerHTML = `<span>${c.label}</span>`;
        const cur = () => state[c.key] || c.options[0][0];
        for (const [v, text] of c.options) {
          const b = document.createElement('button');
          b.textContent = text;
          b.addEventListener('click', () => {
            state[c.key] = v; apply(c, v); save();
            row.querySelectorAll('button').forEach((x, i) => x.setAttribute('aria-pressed', String(c.options[i][0] === v)));
          });
          b.setAttribute('aria-pressed', String(cur() === v));
          row.append(b);
        }
        panel.append(row);
      }

      // Day stepper, only on pages that carry a quote. Not a CONTROLS row: it steps a
      // number rather than choosing one of a set of values.
      const quote = window.__quoteOfTheDay;
      if (quote) {
        const row = document.createElement('div');
        row.className = 'dev-panel-row';
        row.innerHTML = '<span>Day</span>';
        const shown = document.createElement('span');
        shown.className = 'dev-panel-date';
        // Quotes differ in length, so swapping one changes the page's height and the view
        // drifts under you. Two things keep it still: a spacer that stops the page ever
        // getting shorter during a session (at the foot of the page the browser would
        // otherwise pull the view up, and no amount of scrolling could correct it), and a
        // scroll nudge by however far the quote itself moved. Both are local only.
        const el = document.querySelector('.foot blockquote');
        const spacer = document.createElement('div');
        spacer.setAttribute('aria-hidden', 'true');
        document.body.append(spacer);
        let peak = 0;
        const hold = () => {
          spacer.style.height = '0px';
          const h = document.documentElement.scrollHeight;
          peak = Math.max(peak, h);
          spacer.style.height = `${peak - h}px`;
        };
        hold();
        const step = (by) => {
          state.dayOffset = by === 0 ? 0 : (state.dayOffset || 0) + by;
          window.__dayOffset = state.dayOffset;
          save();
          const before = el ? el.getBoundingClientRect().top : 0;
          quote.render();
          hold();
          if (el) {
            const moved = el.getBoundingClientRect().top - before;
            if (moved) scrollBy({ top: moved, behavior: 'instant' });
          }
          shown.textContent = quote.label();
        };
        for (const [text, by] of [['\u2039', -1], ['Today', 0], ['\u203a', 1]]) {
          const b = document.createElement('button');
          b.textContent = text;
          b.addEventListener('click', () => step(by));
          row.append(b);
        }
        row.append(shown);
        panel.append(row);
        // The offset was applied at head time, so the quote on screen is already right for
        // the previewed day; only the date beside the buttons needs filling in.
        shown.textContent = quote.label();
      }

      document.body.append(panel);

      // Dock mode shortens the page by the strip's height rather than covering it, so the
      // measurement has to follow the panel as controls are added or it wraps.
      const measure = () => root.style.setProperty('--dev-panel-h', `${panel.offsetHeight}px`);
      new ResizeObserver(measure).observe(panel);
      measure();

      // Backtick opens and closes the panel, so the page can be read unobstructed.
      addEventListener('keydown', (e) => {
        if (e.key !== '`' || e.metaKey || e.ctrlKey || e.altKey) return;
        const tag = document.activeElement && document.activeElement.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA') return;
        panel.toggleAttribute('data-closed');
        state._open = !panel.hasAttribute('data-closed');
        save();
        measure();
      });
    });
  })();
</script>
<style is:inline>
  /* Docked along the head of the window, and shortening the page by its own height so it
     never covers anything; the site's own sticky bar is pushed down by that height so the
     two cannot overlap. */
  .dev-panel{position:fixed;left:0;right:0;top:0;z-index:1000;box-sizing:border-box;display:flex;flex-wrap:wrap;align-items:center;gap:6px 16px;padding:8px var(--gutter);max-width:100vw;overflow-wrap:anywhere;background:var(--sheet);color:var(--ink);border:2px solid var(--ink);border-width:0 0 2px;font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;box-shadow:0 4px 14px rgba(0,0,0,.12)}
  body{padding-top:var(--dev-panel-h, 0px)}
  .bar{top:var(--dev-panel-h, 0px)}
  .dev-panel button{flex:0 0 auto;font:inherit;letter-spacing:inherit;text-transform:inherit;padding:6px 8px;white-space:nowrap;border:1px solid var(--ink);background:transparent;color:var(--ink);cursor:pointer}
  .dev-panel button[aria-pressed="true"]{background:var(--ink);color:var(--sheet)}
  .dev-panel-head{border:0 !important;padding:0 !important;text-align:left}
  .dev-panel-head::after{content:' ▾'}
  .dev-panel[data-closed] .dev-panel-head::after{content:' ▸'}
  .dev-panel[data-closed] .dev-panel-row{display:none}
  /* Rows wrap within themselves and the strip wraps between them, so nothing runs off a
     narrow screen. The label holds a column so the rows line up while they fit. */
  .dev-panel-row{display:flex;align-items:center;flex-wrap:wrap;gap:4px;max-width:100%}
  .dev-panel-row > span:first-child{flex:0 0 auto;min-width:4.5em;color:var(--ink-3)}
  .dev-panel-date{flex:1 1 auto;min-width:0;margin-left:4px;color:var(--ink-3);white-space:normal;overflow-wrap:anywhere;text-transform:none;letter-spacing:0}
</style>
